{
  "name": "ixiehao-github-io-website-checks",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:website": "node --check scripts/serve-website-tests.mjs && python3 scripts/search-content.py --self-test && python3 scripts/search-content.py --check",
    "test:website": "playwright test",
    "test:website:report": "playwright show-report",
    "build:website": "python3 scripts/search-content.py",
    "notify:search": "python3 scripts/search-content.py --notify"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
